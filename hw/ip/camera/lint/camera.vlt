`verilator_config

lint_off -rule UNDRIVEN -file "*/camera_if.sv" -match "Signal is not driven: 'hw2*"
lint_off -rule UNUSED -file "*/camera_if.sv" -match "Signal is not used*"

lint_off -rule DECLFILENAME -file "*/camera_reg_top.sv" -match "Filename 'camera_reg_top' does not match MODULE name: 'camera_reg_top_intf'"
